<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_gray">

    <LinearLayout
        android:id="@+id/loginCard"
        android:layout_width="0dp"
        android:layout_height="0dp"

        android:background="@drawable/bg_auth_card"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_moodle_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:text="Se connecter"
            android:textColor="@color/text_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:text="Courriel"
            android:textColor="@color/text_soft"
            android:textSize="10sp" />

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="260dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_input"
            android:hint="utilisateur@etsmtl.ca"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:textColor="@color/text_dark"
            android:textSize="12sp" />

        <TextView
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="10dp"
            android:text="Mot de passe"
            android:textColor="@color/text_soft"
            android:textSize="10sp" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="260dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_input"
            android:hint="••••••••"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="@color/text_dark"
            android:textSize="12sp" />

        <Button
            android:id="@+id/loginBtn"
            android:layout_width="120dp"
            android:layout_height="30dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button_orange"
            android:text="Se connecter"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:includeFontPadding="false"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="15dp"
            android:background="@color/divider_soft" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginBottom="40dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vous êtes nouveau à Mini Moodle? "
                android:textColor="@color/text_soft"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/goRegisterText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Créez-vous un compte"
                android:textColor="@color/button_orange"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
