<?xml version="1.0" encoding="utf-8"?>
<!-- Barre de navigation commune aux écrans principaux. Les clics sont branchés dans BaseMoodleActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_bottom_nav"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/navDashboard"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_dashboard"
            android:paddingTop="10dp"
            android:paddingBottom="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_dashboard" />

        <View
            android:id="@+id/navDashboardDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginBottom="1dp"
            android:background="@drawable/bg_nav_dot"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/navAssignments"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_quizzes"
            android:paddingTop="10dp"
            android:paddingBottom="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_quiz" />

        <View
            android:id="@+id/navAssignmentsDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginBottom="1dp"
            android:background="@drawable/bg_nav_dot"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/navCourses"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_courses"
            android:paddingTop="10dp"
            android:paddingBottom="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_book" />

        <View
            android:id="@+id/navCoursesDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginBottom="1dp"
            android:background="@drawable/bg_nav_dot"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/navProfile"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_profile"
            android:paddingTop="10dp"
            android:paddingBottom="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_profile" />

        <View
            android:id="@+id/navProfileDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginBottom="1dp"
            android:background="@drawable/bg_nav_dot"
            android:visibility="invisible" />
    </LinearLayout>

</LinearLayout>
