<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/header_green">

    <LinearLayout
        android:id="@+id/coursesHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/header_green"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="20dp"
        android:paddingEnd="30dp"
        android:paddingBottom="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/courseSearchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_search"
                android:hint="Rechercher un cours"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/text_dark"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/courseSearchButton"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_button_orange"
                android:contentDescription="@string/search_course"
                android:padding="8dp"
                android:src="@drawable/ic_search" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/coursesDome"
        android:layout_width="700dp"
        android:layout_height="80dp"
        android:layout_marginTop="-20dp"
        android:background="@drawable/bg_dome_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/coursesHeader" />

    <LinearLayout
        android:id="@+id/courseFilters"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="-40dp"
        android:background="@color/white"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="34dp"
        android:paddingEnd="34dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/coursesDome">

        <Button
            android:id="@+id/filterAllBtn"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_selected"
            android:text="Tout"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/filterActiveBtn"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_button"
            android:text="Session"
            android:textAllCaps="false"
            android:textColor="@color/button_orange"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/filterFinishedBtn"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_button"
            android:text="Terminé"
            android:textAllCaps="false"
            android:textColor="@color/button_orange"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/coursesScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/white"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/coursesBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/courseFilters">

        <LinearLayout
            android:id="@+id/coursesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="18dp" />
    </ScrollView>

    <include
        android:id="@+id/coursesBottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
