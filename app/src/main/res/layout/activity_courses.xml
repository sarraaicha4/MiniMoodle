<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/header_green"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/coursesHeader"
        android:layout_width="match_parent"
        android:layout_height="171dp"
        android:background="@color/header_green"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="20dp"
        android:paddingEnd="30dp"
        android:paddingBottom="0dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cours"
            android:textColor="@color/white"
            android:textSize="48sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/courseSearchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_search"
                android:hint="Rechercher un cours"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/text_dark"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/courseSearchButton"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_button_orange"
                android:contentDescription="@string/search_course"
                android:padding="8dp"
                android:src="@drawable/ic_search" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="700dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="-70dp"
        android:background="@drawable/bg_dome_white" />

    <ScrollView
        android:id="@+id/coursesScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:ignore="all">

            <LinearLayout
                android:id="@+id/courseFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="34dp"
                android:paddingTop="8dp"
                android:paddingEnd="34dp"
                android:paddingBottom="8dp">

                <Button
                    android:id="@+id/filterAllBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_filter_selected"
                    android:text="Tout"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/filterActiveBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_filter_button"
                    android:text="Session"
                    android:textAllCaps="false"
                    android:textColor="@color/button_orange"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/filterFinishedBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_filter_button"
                    android:text="Terminé"
                    android:textAllCaps="false"
                    android:textColor="@color/button_orange"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/coursesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="18dp">

                <include
                    layout="@layout/item_course_card"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <include
                    layout="@layout/item_course_card"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <include
                    layout="@layout/item_course_card"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/coursesBottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp" />

</LinearLayout>
