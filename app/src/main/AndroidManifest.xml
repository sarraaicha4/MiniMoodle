<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.MiniMoodle">
        <activity
            android:name=".activites.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".activites.RegisterActivity" android:exported="false" />
        <activity android:name=".activites.MainActivity" android:exported="false" />
        <activity android:name=".activites.QuizActivity" android:exported="false" />
        <activity android:name=".activites.AssignmentsActivity" android:exported="false" />
        <activity android:name=".activites.CoursesActivity" android:exported="false" />
        <activity android:name=".activites.CourseDetailActivity" android:exported="false" />
        <activity android:name=".activites.ProfileActivity" android:exported="false" />
    </application>

</manifest>
